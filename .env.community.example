# Minutes Community — copy to .env before starting Docker Compose.
# Do not commit .env. Set unique values for the three settings below.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@minutes.local
ADMIN_PASSWORD=replace-with-a-unique-password

# Optional deployment-wide API credentials. Alternatively, each user can add
# their own credentials in Settings. Leave these unset for local-model mode.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional LLM override; choose a model available through your provider.
# LLM_MODEL=

# Browser-visible API URL, baked into the frontend at build time.
# Rebuild phone-recorder after changing it. localhost means this same computer.
# VITE_API_URL=http://localhost:8002
# FRONTEND_PORT=9002

# Optional MinIO credentials. Compose supplies development defaults when unset.
# Change these before exposing the deployment, and use the same values across
# MinIO, the API, and the worker. Database/storage URLs are set by base Compose.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
