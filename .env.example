# Legacy DeepSeek key (kept for reference, no longer the default provider)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenRouter uses the OpenAI-compatible interface for both transcription and LLM calls.
OPENAI_API_KEY=your-openrouter-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt4o
STT_MODE=cloud
LLM_MODE=cloud

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://meeting_user:meeting_password@postgres:5432/meeting_notes

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO

# Storage Configuration
STORAGE_DIR=./storage/meetings

# CORS Origins (comma-separated, used by backend)
CORS_ORIGINS=http://localhost:9002,http://localhost:3000

# Cloud edition only: Manor OAuth 2.0 sign-in
# Run manor-cloud/scripts/seed_oauth_client_pms.py with
# MANOR_PMS_OAUTH_CLIENT_ID=minutes-cloud to generate the client secret.
# The client secret is server-side only. MANOR_OAUTH_REDIRECT_URI must match
# the redirect URI registered in Manor.
MANOR_OAUTH_CLIENT_ID=minutes-cloud
MANOR_OAUTH_CLIENT_SECRET=
MANOR_OAUTH_AUTHORIZE_URL=https://app.manorai.xyz/oauth/authorize
MANOR_OAUTH_TOKEN_URL=https://app.manorai.xyz/api/v1/oauth/token
MANOR_OAUTH_REDIRECT_URI=https://minutes.manorai.xyz/auth/manor-callback

# Cloud edition only: Google sign-in through Manor API
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=
MANOR_GOOGLE_OAUTH_URL=https://app.manorai.xyz/api/v1/auth/oauth/google
MANOR_GOOGLE_PROFILE_URL=https://app.manorai.xyz/api/v1/auth/me

# Storage (default: local filesystem)
# Set to "minio" to use MinIO object storage
STORAGE_BACKEND=local
# MINIO_ENDPOINT=localhost:9012
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=minutes-audio
# MINIO_SECURE=false
