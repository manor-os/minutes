# Legacy DeepSeek key (kept for reference, no longer the default provider)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenRouter API (shared key with manor-multi-agent — used for summarization & speaker ID)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenAI API (for Whisper transcription only — OpenRouter does not proxy Whisper)
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://meeting_user:meeting_password@postgres:5432/meeting_notes

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO

# Storage Configuration
STORAGE_DIR=./storage/meetings

# CORS Origins (comma-separated, used by backend)
CORS_ORIGINS=http://localhost:9002,http://localhost:3000

# Storage (default: local filesystem)
# Set to "minio" to use MinIO object storage
STORAGE_BACKEND=local
# MINIO_ENDPOINT=localhost:9012
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=minutes-audio
# MINIO_SECURE=false

# --- Manor AI SSO + credit billing (Cloud edition only) ---
# Set EDITION=cloud to enable. The block below is ignored in community mode.
# EDITION=cloud
#
# OAuth2 client credentials issued by Manor for this minutes deployment.
# MANOR_BASE_URL=https://app.manorai.xyz
# MANOR_CLIENT_ID=
# MANOR_CLIENT_SECRET=
# MANOR_REDIRECT_URI=https://minutes.example.com/api/auth/manor/callback
# MANOR_OAUTH_SCOPE=openid profile email subscriptions
#
# Override these only if Manor's endpoint paths differ from the defaults.
# MANOR_AUTHORIZE_PATH=/oauth/authorize
# MANOR_TOKEN_PATH=/oauth/token
# MANOR_USERINFO_PATH=/api/me
# MANOR_SUBSCRIPTION_PATH=/api/subscriptions/minutes
# MANOR_MINUTES_PRODUCT=minutes
#
# Where the browser lands after Manor login.
# MANOR_LOGIN_SUCCESS_REDIRECT=https://minutes.example.com/auth/manor
# MANOR_LOGIN_FAILURE_REDIRECT=https://minutes.example.com/auth/manor
#
# Comma-separated allowlist of extra post-login redirect URL prefixes accepted
# from the `?redirect=` query param. Browser-extension OAuth domains
# (chromiumapp.org / extensions.allizom.org) are always allowed automatically.
# MANOR_ALLOWED_FINAL_REDIRECTS=https://minutes-staging.example.com/
#
# Service-to-service API key used by the celery worker to charge Manor credits
# when a meeting finishes processing. Distinct from MANOR_CLIENT_SECRET.
# MANOR_SERVICE_API_KEY=
# MANOR_BILLING_PATH=/api/credits/charge
